{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sentinel-manifest-v2",
  "title": "Sentinel 2.0 deterministic manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "generatedAt",
    "target",
    "coverage",
    "routes",
    "operations",
    "schemas"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "2.0" },
    "generatedAt": { "type": "string", "minLength": 1 },
    "target": { "$ref": "#/$defs/target" },
    "coverage": { "$ref": "#/$defs/coverage" },
    "routes": {
      "type": "array",
      "items": { "$ref": "#/$defs/route" }
    },
    "operations": {
      "type": "array",
      "items": { "$ref": "#/$defs/operation" }
    },
    "schemas": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/schemaRecord" }
    },
    "auth": { "$ref": "#/$defs/auth" },
    "services": {
      "type": "array",
      "items": { "$ref": "#/$defs/service" }
    },
    "i18n": { "$ref": "#/$defs/analysis" },
    "a11y": { "$ref": "#/$defs/analysis" },
    "deadCode": { "$ref": "#/$defs/analysis" },
    "deadCss": { "$ref": "#/$defs/analysis" },
    "n1Queries": { "$ref": "#/$defs/analysis" },
    "vulnerabilities": { "$ref": "#/$defs/analysis" },
    "apiVersioning": { "$ref": "#/$defs/analysis" },
    "migrationDrift": { "$ref": "#/$defs/analysis" },
    "rateLimiting": { "$ref": "#/$defs/analysis" }
  },
  "$defs": {
    "target": {
      "type": "object",
      "required": ["name", "root"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "root": { "type": "string", "minLength": 1 },
        "framework": { "$ref": "#/$defs/framework" }
      }
    },
    "framework": {
      "type": "object",
      "required": ["frontend", "backend"],
      "additionalProperties": false,
      "properties": {
        "frontend": {
          "type": "string",
          "enum": ["vue", "nuxt", "nextjs", "react", "sveltekit", "angular", "remix", "none", "unknown"]
        },
        "backend": {
          "type": "string",
          "enum": ["fastapi", "express", "django", "nestjs", "nextjs", "flask", "hono", "koa", "remix", "actix", "axum", "rocket", "gin", "echo", "chi", "laravel", "graphql", "grpc", "trpc", "none", "unknown"]
        }
      }
    },
    "auth": {
      "type": "object",
      "required": ["method"],
      "additionalProperties": false,
      "properties": {
        "method": {
          "type": "string",
          "enum": ["bearer", "jwt", "nextauth", "session", "apikey", "oauth_pkce", "none", "unknown"]
        }
      }
    },
    "service": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "sourcePath": { "type": ["string", "null"] }
      }
    },
    "analysis": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["status", "diagnostics"],
          "additionalProperties": false,
          "properties": {
            "status": {
              "type": "string",
              "enum": ["complete", "partial", "unsupported"]
            },
            "diagnostics": {
              "type": "array",
              "items": { "$ref": "#/$defs/diagnostic" }
            }
          }
        }
      ]
    },
    "coverage": {
      "type": "object",
      "required": ["status", "diagnostics"],
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": ["complete", "partial", "unsupported"]
        },
        "diagnostics": {
          "type": "array",
          "items": { "$ref": "#/$defs/diagnostic" }
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "required": ["code", "message"],
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "sourcePath": { "type": ["string", "null"] },
        "pointer": { "type": ["string", "null"] }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["adapter", "sourcePath"],
      "additionalProperties": false,
      "properties": {
        "adapter": {
          "type": "string",
          "enum": ["openapi", "vue-router"]
        },
        "sourcePath": { "type": "string", "minLength": 1 },
        "pointer": { "type": ["string", "null"] }
      }
    },
    "authorization": {
      "type": "object",
      "required": ["state", "roles"],
      "additionalProperties": false,
      "properties": {
        "state": {
          "type": "string",
          "enum": ["public", "authenticated", "roles", "unknown"]
        },
        "roles": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "parameter": {
      "type": "object",
      "required": ["name", "location", "required", "schema"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "location": {
          "type": "string",
          "enum": ["path", "query", "header", "cookie"]
        },
        "required": { "type": "boolean" },
        "schema": { "$ref": "#/$defs/schemaNode" },
        "example": {}
      }
    },
    "route": {
      "type": "object",
      "required": ["id", "path", "authorization", "parameters", "provenance"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "pattern": "^/" },
        "name": { "type": ["string", "null"] },
        "component": { "type": ["string", "null"] },
        "aliases": {
          "type": "array",
          "items": { "type": "string", "pattern": "^/" }
        },
        "authorization": { "$ref": "#/$defs/authorization" },
        "parameters": {
          "type": "array",
          "items": { "$ref": "#/$defs/parameter" }
        },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "operation": {
      "type": "object",
      "required": [
        "id",
        "method",
        "path",
        "parameters",
        "authorization",
        "sideEffects",
        "mutation",
        "risk",
        "provenance"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "method": {
          "type": "string",
          "enum": ["GET", "HEAD", "OPTIONS", "POST", "PUT", "PATCH", "DELETE"]
        },
        "path": { "type": "string", "pattern": "^/" },
        "summary": { "type": ["string", "null"] },
        "parameters": {
          "type": "array",
          "items": { "$ref": "#/$defs/parameter" }
        },
        "requestBody": {
          "anyOf": [
            { "type": "null" },
            { "$ref": "#/$defs/requestBody" }
          ]
        },
        "responses": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/response" }
        },
        "authorization": { "$ref": "#/$defs/authorization" },
        "targetModel": { "type": ["string", "null"] },
        "deleteMode": {
          "type": ["string", "null"],
          "enum": ["soft", "hard", "unknown", null]
        },
        "sideEffects": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "rollback": { "type": ["string", "null"] },
        "mutation": { "type": "boolean" },
        "protocol": {
          "type": "string",
          "enum": ["http", "websocket"]
        },
        "sweepable": { "type": "boolean" },
        "risk": { "$ref": "#/$defs/risk" },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "requestBody": {
      "type": "object",
      "required": ["required", "contentType", "schema"],
      "additionalProperties": false,
      "properties": {
        "required": { "type": "boolean" },
        "contentType": { "type": "string", "minLength": 1 },
        "schema": { "$ref": "#/$defs/schemaNode" }
      }
    },
    "response": {
      "type": "object",
      "required": ["contentType", "schema"],
      "additionalProperties": false,
      "properties": {
        "contentType": { "type": ["string", "null"] },
        "schema": {
          "anyOf": [
            { "type": "null" },
            { "$ref": "#/$defs/schemaNode" }
          ]
        }
      }
    },
    "risk": {
      "type": "object",
      "required": ["score", "level", "reasons"],
      "additionalProperties": false,
      "properties": {
        "score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "level": {
          "type": "string",
          "enum": ["safe", "medium", "high", "critical"]
        },
        "reasons": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "schemaRecord": {
      "type": "object",
      "required": ["schema", "provenance"],
      "additionalProperties": false,
      "properties": {
        "schema": { "$ref": "#/$defs/schemaNode" },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "schemaNode": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "$ref": { "type": "string", "minLength": 1 },
        "type": {
          "anyOf": [
            { "type": "string" },
            {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string" }
            }
          ]
        },
        "const": {},
        "enum": { "type": "array", "items": {} },
        "required": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "properties": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/schemaNode" }
        },
        "additionalProperties": {
          "anyOf": [
            { "type": "boolean" },
            { "$ref": "#/$defs/schemaNode" }
          ]
        },
        "items": { "$ref": "#/$defs/schemaNode" },
        "minItems": { "type": "integer", "minimum": 0 },
        "minLength": { "type": "integer", "minimum": 0 },
        "pattern": { "type": "string" },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" },
        "anyOf": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/schemaNode" }
        },
        "oneOf": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/schemaNode" }
        },
        "allOf": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/schemaNode" }
        }
      }
    }
  }
}
