{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sentinel-settings-v2",
  "title": "Sentinel 2.0 trusted settings",
  "type": "object",
  "required": [
    "schemaVersion",
    "requireConfigPath",
    "reportDir",
    "approvedOrigins",
    "roles",
    "allowMutations",
    "mutationAllowlist",
    "allowNonLoopback",
    "targetEnvironment",
    "requireCompleteCoverage",
    "maxConcurrency",
    "responseTimeoutMs",
    "browserSettleMs",
    "viewports"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "2.0" },
    "requireConfigPath": { "const": true },
    "reportDir": { "type": "string", "minLength": 1 },
    "approvedOrigins": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^https?://[^/?#]+$"
      }
    },
    "roles": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/role" }
    },
    "allowMutations": { "type": "boolean" },
    "mutationAllowlist": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "allowNonLoopback": { "type": "boolean" },
    "targetEnvironment": {
      "type": "string",
      "enum": ["unknown", "development", "test", "staging", "production"]
    },
    "requireCompleteCoverage": { "type": "boolean" },
    "maxConcurrency": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32
    },
    "responseTimeoutMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120000
    },
    "browserSettleMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "viewports": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 10000
      }
    },
    "chromePath": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "emptyContainerSelectors": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "screenshotOnError": { "type": "boolean" },
    "maxResponseBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 104857600
    },
    "retentionRuns": {
      "type": "integer",
      "minimum": 1
    },
    "operationRoles": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/roleNames" }
    },
    "routeRoles": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/roleNames" }
    },
    "parameterExamples": {
      "type": "array",
      "items": { "$ref": "#/$defs/parameterExample" }
    },
    "services": {
      "type": "array",
      "items": { "$ref": "#/$defs/service" }
    }
  },
  "$defs": {
    "role": {
      "type": "object",
      "required": ["tokenRef"],
      "additionalProperties": false,
      "properties": {
        "tokenRef": {
          "type": "string",
          "pattern": "^env:[A-Z][A-Z0-9_]{1,127}$"
        }
      }
    },
    "roleNames": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "parameterExample": {
      "type": "object",
      "required": ["operationId", "location", "name", "value"],
      "additionalProperties": false,
      "properties": {
        "operationId": { "type": "string", "minLength": 1 },
        "location": {
          "type": "string",
          "enum": ["path", "query", "header"]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!(?:password|token)$).+"
        },
        "value": {
          "type": ["string", "number", "integer", "boolean"]
        }
      }
    },
    "service": {
      "type": "object",
      "required": ["name", "approvedOrigin"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "approvedOrigin": {
          "type": "string",
          "pattern": "^https?://[^/?#]+$"
        },
        "sourcePath": { "type": "string", "minLength": 1 }
      }
    }
  }
}
