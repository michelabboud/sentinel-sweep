{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sentinel-history-v2",
  "title": "Sentinel 2.0 sweep history",
  "type": "object",
  "required": ["schemaVersion", "runs"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "2.0" },
    "runs": {
      "type": "array",
      "items": { "$ref": "#/$defs/run" }
    }
  },
  "$defs": {
    "run": {
      "type": "object",
      "required": [
        "runId",
        "startedAt",
        "finishedAt",
        "coverageStatus",
        "summary"
      ],
      "additionalProperties": false,
      "properties": {
        "runId": { "type": "string", "minLength": 1 },
        "startedAt": { "type": "string", "minLength": 1 },
        "finishedAt": { "type": "string", "minLength": 1 },
        "coverageStatus": {
          "type": "string",
          "enum": ["complete", "partial", "unsupported"]
        },
        "summary": { "$ref": "#/$defs/summary" },
        "healthScore": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
        "commitSha": { "type": ["string", "null"] }
      }
    },
    "summary": {
      "type": "object",
      "required": ["critical", "error", "warning", "info", "skipped"],
      "additionalProperties": false,
      "properties": {
        "critical": { "type": "integer", "minimum": 0 },
        "error": { "type": "integer", "minimum": 0 },
        "warning": { "type": "integer", "minimum": 0 },
        "info": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
