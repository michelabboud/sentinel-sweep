{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sweep-history.schema.json",
  "title": "Sentinel Sweep History",
  "description": "Schema for sweep-history.json that accumulates summary data from each sweep run, enabling cross-run trend analysis via /sentinel trends.",
  "type": "object",
  "required": ["runs"],
  "properties": {
    "runs": {
      "type": "array",
      "description": "Chronological list of sweep run summaries. Entries are appended after each sweep; none are removed automatically.",
      "items": {
        "$ref": "#/$defs/run"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "run": {
      "type": "object",
      "description": "Summary of a single sweep run.",
      "required": [
        "runId",
        "mode",
        "duration",
        "rolesTested",
        "routesTested",
        "endpointsTested",
        "findings",
        "passed",
        "passRate",
        "sandboxMode",
        "timestamp"
      ],
      "properties": {
        "runId": {
          "type": "string",
          "description": "Filesystem-safe ISO timestamp matching the run directory name (e.g. 2026-03-15T14-30-00Z)."
        },
        "mode": {
          "type": "string",
          "enum": ["browser + api", "api-only"],
          "description": "Sweep mode: full browser+api or api-only."
        },
        "duration": {
          "type": "string",
          "description": "Human-readable elapsed time (e.g. '2m 34s', 'unknown')."
        },
        "rolesTested": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Deduplicated list of roles exercised in the run."
        },
        "routesTested": {
          "type": "integer",
          "minimum": 0,
          "description": "Total browser routes tested."
        },
        "endpointsTested": {
          "type": "integer",
          "minimum": 0,
          "description": "Total API endpoints tested."
        },
        "findings": {
          "type": "object",
          "description": "Finding counts keyed by severity level.",
          "required": ["critical", "error", "warning", "info"],
          "properties": {
            "critical": {
              "type": "integer",
              "minimum": 0,
              "description": "Number of critical-severity findings."
            },
            "error": {
              "type": "integer",
              "minimum": 0,
              "description": "Number of error-severity findings."
            },
            "warning": {
              "type": "integer",
              "minimum": 0,
              "description": "Number of warning-severity findings."
            },
            "info": {
              "type": "integer",
              "minimum": 0,
              "description": "Number of info-severity findings."
            }
          },
          "additionalProperties": false
        },
        "passed": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of checks that produced no critical/error/warning finding."
        },
        "passRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Pass rate as percentage: passed / (passed + critical + error + warning) * 100, rounded to 1 decimal."
        },
        "sandboxMode": {
          "type": "boolean",
          "description": "Whether --sandbox was active for this run."
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 UTC timestamp of when the run completed."
        }
      },
      "additionalProperties": false
    }
  }
}
