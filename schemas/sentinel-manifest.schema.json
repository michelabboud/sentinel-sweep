{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sentinel-manifest.schema.json",
  "title": "Sentinel Manifest",
  "description": "Schema for sentinel-manifest.json produced by the manifest-generator agent. Describes frontend routes, backend endpoints, schemas, CRUD flows, auth config, risk policy, and cross-cutting analysis results.",
  "type": "object",
  "required": ["generatedAt", "app", "auth", "routes", "endpoints", "crudFlows", "schemas"],
  "properties": {
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 UTC timestamp of when the manifest was generated."
    },
    "app": {
      "type": "object",
      "description": "Application metadata.",
      "required": ["name", "framework", "baseUrl", "apiBaseUrl"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Application name derived from package.json, pyproject.toml, Cargo.toml, composer.json, or directory name."
        },
        "framework": {
          "type": "object",
          "required": ["frontend", "backend"],
          "properties": {
            "frontend": {
              "type": "string",
              "enum": ["vue", "nuxt", "nextjs", "react", "sveltekit", "angular", "remix", "none"],
              "description": "Detected frontend framework."
            },
            "backend": {
              "type": "string",
              "enum": ["fastapi", "express", "django", "nestjs", "nextjs", "flask", "hono", "koa", "remix", "actix", "axum", "rocket", "gin", "echo", "chi", "laravel", "grpc", "trpc", "graphql", "none"],
              "description": "Detected backend framework."
            }
          },
          "additionalProperties": false
        },
        "baseUrl": {
          "type": "string",
          "format": "uri",
          "description": "Frontend base URL (e.g. http://localhost:3000)."
        },
        "apiBaseUrl": {
          "type": "string",
          "format": "uri",
          "description": "API base URL (e.g. http://localhost:8000)."
        }
      },
      "additionalProperties": false
    },
    "auth": {
      "type": "object",
      "description": "Authentication configuration.",
      "required": ["method", "loginEndpoint", "roleHierarchy", "roles"],
      "properties": {
        "method": {
          "type": "string",
          "enum": ["jwt", "nextauth", "session", "apikey", "oauth_pkce", "none"],
          "description": "Detected authentication method."
        },
        "loginEndpoint": {
          "type": ["string", "null"],
          "description": "Full path to the login endpoint. Null if no login endpoint found."
        },
        "roleHierarchy": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "description": "Ordered list of roles from most access to least."
        },
        "roles": {
          "type": "object",
          "description": "Test credentials keyed by role name.",
          "additionalProperties": {
            "type": "object",
            "required": ["email", "password"],
            "properties": {
              "email": { "type": "string" },
              "password": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "oauth": {
          "type": ["object", "null"],
          "description": "OAuth PKCE configuration (v1.5.0+). Null if not using OAuth.",
          "properties": {
            "authorizeUrl": { "type": "string" },
            "tokenUrl": { "type": "string" },
            "clientId": { "type": "string" },
            "redirectUri": { "type": "string" },
            "scopes": { "type": "string" }
          }
        }
      },
      "additionalProperties": false
    },
    "services": {
      "type": "array",
      "description": "Multi-service definitions (v1.3.0+). Empty array for single-service mode.",
      "default": [],
      "items": {
        "type": "object",
        "required": ["name", "apiBaseUrl"],
        "properties": {
          "name": { "type": "string" },
          "apiBaseUrl": { "type": "string", "format": "uri" },
          "baseUrl": { "type": "string", "format": "uri" },
          "sourcePath": { "type": "string" },
          "auth": { "type": ["object", "null"] }
        }
      }
    },
    "routes": {
      "type": "array",
      "description": "Frontend routes.",
      "items": { "$ref": "#/$defs/route" }
    },
    "endpoints": {
      "type": "array",
      "description": "Backend API endpoints.",
      "items": { "$ref": "#/$defs/endpoint" }
    },
    "crudFlows": {
      "type": "array",
      "description": "Detected CRUD lifecycle flows.",
      "items": { "$ref": "#/$defs/crudFlow" }
    },
    "schemas": {
      "type": "object",
      "description": "Schema definitions from Pydantic, Zod, TypeScript, Django serializers, Rust serde, Go structs, GraphQL types, or Laravel FormRequest.",
      "additionalProperties": { "$ref": "#/$defs/schemaDefinition" }
    },
    "breakpoints": {
      "type": "array",
      "items": { "type": "integer", "minimum": 1 }
    },
    "riskPolicy": { "$ref": "#/$defs/riskPolicy" },
    "i18n": {
      "type": ["object", "null"],
      "description": "i18n analysis results (v1.5.0+). Null if no i18n system detected."
    },
    "a11y": {
      "type": ["object", "null"],
      "description": "Accessibility analysis results (v1.6.0+). Null if no frontend detected."
    },
    "deadCode": {
      "type": ["object", "null"],
      "description": "Dead endpoint/route detection results (v1.6.0+). Null if no dead code found."
    },
    "deadCss": {
      "type": ["object", "null"],
      "description": "CSS/Tailwind dead class analysis results (v1.7.1+). Null if no CSS system detected."
    },
    "n1Queries": {
      "type": ["object", "null"],
      "description": "N+1 query detection results (v1.8.0+). Null if no N+1 patterns found."
    },
    "vulnerabilities": {
      "type": ["object", "null"],
      "description": "Dependency vulnerability scanning results (v1.8.0+). Null if no package managers found."
    },
    "apiVersioning": {
      "type": ["object", "null"],
      "description": "API versioning analysis results (v1.7.0+). Null if single version."
    },
    "migrationDrift": {
      "type": ["object", "null"],
      "description": "Database migration drift detection results (v1.7.0+). Null if no drift found."
    },
    "rateLimiting": {
      "type": ["object", "null"],
      "description": "Rate limiting detection results (v1.7.0+). Null if no rate limiting detected."
    }
  },
  "additionalProperties": true,
  "$defs": {
    "riskLevel": {
      "type": "string",
      "enum": ["safe", "medium", "high", "critical"]
    },
    "riskScore": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "paramValue": {
      "type": "string",
      "pattern": "^(lookup:|static:|env:).+"
    },
    "route": {
      "type": "object",
      "required": ["path", "view", "requiredRole", "riskLevel", "riskScore", "params"],
      "properties": {
        "path": { "type": "string" },
        "view": { "type": "string" },
        "requiredRole": { "type": ["string", "null"] },
        "riskLevel": { "$ref": "#/$defs/riskLevel" },
        "riskScore": { "$ref": "#/$defs/riskScore" },
        "params": {
          "type": ["object", "null"],
          "additionalProperties": { "$ref": "#/$defs/paramValue" }
        },
        "description": { "type": ["string", "null"] },
        "service": { "type": ["string", "null"] },
        "manual": { "type": "boolean", "default": false }
      },
      "additionalProperties": false
    },
    "endpoint": {
      "type": "object",
      "required": ["method", "path", "requiredRole", "riskLevel", "riskScore", "responseSchema", "description", "sideEffects", "requiresConfirm", "params"],
      "properties": {
        "method": {
          "type": "string",
          "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"]
        },
        "path": { "type": "string" },
        "requiredRole": { "type": ["string", "null"] },
        "riskLevel": { "$ref": "#/$defs/riskLevel" },
        "riskScore": { "$ref": "#/$defs/riskScore" },
        "responseSchema": { "type": ["string", "null"] },
        "description": { "type": ["string", "null"] },
        "sideEffects": {
          "type": "array",
          "items": { "type": "string" }
        },
        "requiresConfirm": { "type": "boolean" },
        "params": {
          "type": ["object", "null"],
          "additionalProperties": { "$ref": "#/$defs/paramValue" }
        },
        "service": { "type": ["string", "null"] },
        "protocol": {
          "type": "string",
          "enum": ["http", "websocket"],
          "default": "http"
        },
        "sweepable": {
          "type": "boolean",
          "default": true
        },
        "manual": { "type": "boolean", "default": false }
      },
      "additionalProperties": false
    },
    "crudFlow": {
      "type": "object",
      "required": ["name", "steps", "riskLevel", "manual"],
      "properties": {
        "name": { "type": "string" },
        "steps": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 2
        },
        "riskLevel": { "$ref": "#/$defs/riskLevel" },
        "manual": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "schemaDefinition": {
      "type": "object",
      "required": ["source", "fields"],
      "properties": {
        "source": { "type": "string" },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["type", "required", "nullable"],
            "properties": {
              "type": {
                "type": "string",
                "enum": ["string", "number", "boolean", "array", "object"]
              },
              "required": { "type": "boolean" },
              "nullable": { "type": "boolean" }
            },
            "additionalProperties": true
          }
        },
        "note": { "type": "string" },
        "schemaOverride": { "type": "object" }
      },
      "additionalProperties": false
    },
    "riskPolicy": {
      "type": "object",
      "required": ["maxRiskLevel", "alwaysSkip", "alwaysAllow"],
      "properties": {
        "maxRiskLevel": { "$ref": "#/$defs/riskLevel" },
        "alwaysSkip": {
          "type": "array",
          "items": { "type": "string" }
        },
        "alwaysAllow": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    }
  }
}
